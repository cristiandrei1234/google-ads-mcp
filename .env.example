# Where this file is read from, in order (first one that exists wins):
#   1. $GOOGLE_ADS_MCP_ENV
#   2. ~/.config/google-ads-mcp/.env
#   3. <package>/.env  (this file, for a local clone)
# Variables already exported in the environment always take precedence.
# GOOGLE_ADS_MCP_ENV=/absolute/path/to/.env

# Required for multi-tenant mode (HTTP transport, orgs, grants, audit trail).
# Leave it unset for single-operator stdio: the server then needs no database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/google_ads_mcp?schema=public
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
# Credentials for single-operator mode. Either this or DATABASE_URL must be set.
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890 (optional for list customers)
MERCHANT_CENTER_ID=your_merchant_center_id (optional)
LOG_LEVEL=info

# Which tool groups to register. Comma-separated, or 'all'.
# Groups: core, reporting, keywords, negatives, audiences, conversions, assets,
# shopping, planning, experiments, bidding, billing, admin, resources.
# GOOGLE_ADS_TOOLSETS=core,reporting

# Ceiling on the characters a single tool result may put into the model's
# context (default 100000). Oversized results are truncated with a message
# saying how many rows came back and what to narrow.
# GOOGLE_ADS_MAX_RESULT_CHARS=100000

# Encryption key for Google Ads refresh tokens at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Better Auth (multi-tenant employee auth) — required once HTTP transport is wired.
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional email (Resend). Leave RESEND_API_KEY empty in dev (emails are
# logged, not sent, and email verification stays off).
RESEND_API_KEY=
EMAIL_FROM="Google Ads MCP <no-reply@example.com>"
# EMAIL_VERIFICATION=on|off  (default: on when RESEND_API_KEY is set)
